APP_ENV=development
APP_VERSION=0.1.0

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

POSTGRES_HOST=127.0.0.1
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fastapi_core_graphql
POSTGRES_PORT=5432

POSTGRES_HOST_TEST=127.0.0.1
POSTGRES_USER_TEST=postgres
POSTGRES_PASSWORD_TEST=postgres
POSTGRES_DB_TEST=fastapi_core_graphql_test
POSTGRES_PORT_TEST=5432

JWT_SECRET=change-me-super-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=10

# Create seed users only when missing. Keep false in production unless intentional.
SEED_ON_BOOT=true

SUPER_USER_NAME=admin
SUPER_USER_USERNAME=admin
SUPER_USER_PASSWORD=admin

MEMBER_USER_NAME=member
MEMBER_USER_USERNAME=member
MEMBER_USER_PASSWORD=member
